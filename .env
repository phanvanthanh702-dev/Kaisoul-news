# ========================================
# KAISOUL NEWS SERVER
# ========================================

# ========================================
# SERVER
# ========================================
PORT=3000
NODE_ENV=development


# ========================================
# KAISOUL ID ADMIN
# ========================================
# Chỉ ghi KAISOUL ID.
# KHÔNG ghi mật khẩu.
#
# Ví dụ:
# ADMIN_WHITELIST=YOUR_KAISOUL_ID
#
ADMIN_WHITELIST= SODK-975421/003//KAISOULID


# ========================================
# JWT
# ========================================
# Secret dùng để ký/xác thực phiên đăng nhập.
# Hãy thay giá trị này bằng một chuỗi ngẫu nhiên dài.
#
JWT_SECRET=KNS_2026_v9F4xQ7mP2L8sR6dT1zW5nC3


# ========================================
# CORS
# ========================================
# Khi chạy local:
CORS_ORIGIN=http://localhost:3000

# Khi frontend được deploy chính thức,
# đổi thành domain frontend của KAISOUL NEWS.
#
# Ví dụ:
# CORS_ORIGIN=https://your-domain.com


# ========================================
# KAISOUL ID
# ========================================
# URL hệ thống KAISOUL ID hiện tại.
KAISOUL_ID_URL=https://phanvanthanh702-dev.github.io/KAISOUL-ID/


# ========================================
# DATABASE
# ========================================
# MVP hiện tại sử dụng dữ liệu trong RAM.
# Chưa cần DATABASE_URL.
#
# Khi chuyển sang PostgreSQL có thể thêm:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kaisoul_news


# ========================================
# SECURITY
# ========================================
# Giới hạn kích thước request.
MAX_REQUEST_SIZE=2mb


# ========================================
# NEWS
# ========================================
# Không tạo dữ liệu giả.
# Thống kê bài viết bắt đầu từ 0.
ALLOW_FAKE_STATS=false
